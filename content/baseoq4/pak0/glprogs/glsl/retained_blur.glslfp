// Retained UI soft focus (REN-016): one pass of a separable Gaussian blur over
// Source, then saturation. blur.xy is one source texel along the pass's axis,
// blur.z the sigma in texels and blur.w the saturation, 1 keeping the colour.
// The output is opaque: it replaces the backdrop it was taken from.
uniform sampler2D Source;
uniform vec4 blur;

varying vec2 blurTexCoord;

void main(void)
{
	float sigma = max( blur.z, 0.0 );
	vec3 sum = texture2D( Source, blurTexCoord ).rgb;
	float total = 1.0;
	if ( sigma > 0.0 ) {
		// 24 taps each side reach 3 sigma; a wider kernel spaces them out and
		// bilinear filtering covers the gaps between them.
		float spacing = max( 1.0, sigma * 0.125 );
		float falloff = -0.5 / ( sigma * sigma );
		for ( int i = 1; i <= 24; i++ ) {
			float x = float( i ) * spacing;
			float weight = exp( x * x * falloff );
			vec2 offset = blur.xy * x;
			sum += ( texture2D( Source, blurTexCoord + offset ).rgb + texture2D( Source, blurTexCoord - offset ).rgb ) * weight;
			total += 2.0 * weight;
		}
	}
	vec3 colour = sum / total;
	float luma = dot( colour, vec3( 0.2126, 0.7152, 0.0722 ) );
	gl_FragColor = vec4( mix( vec3( luma ), colour, clamp( blur.w, 0.0, 1.0 ) ), 1.0 );
}
