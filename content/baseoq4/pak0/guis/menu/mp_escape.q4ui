     },
     {
      "op": "if",
      "condition": {
       "op": "&&",
       "args": [
        {"op": "<", "args": [1, {"state": "mp.players.a.count"}]},
        {"op": "==", "args": [{"state": "mp.players.a1.client"}, {"state": "mp.stat.client"}]}
       ]
      },
