 "events": {
  "join_slot_0": [
   {
    "op": "if",
    "condition": {"state": "mp.join0.available"},
    "then": [{"op": "setState", "values": {"card.welcome_action": 0}}, {"op": "action", "action": "mpWelcomeAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-join-slot-0"}]
   }
  ],
  "join_slot_1": [
   {
    "op": "if",
    "condition": {"state": "mp.join1.available"},
    "then": [{"op": "setState", "values": {"card.welcome_action": 1}}, {"op": "action", "action": "mpWelcomeAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-join-slot-1"}]
   }
  ],
  "join_slot_2": [
   {
    "op": "if",
    "condition": {"state": "mp.join2.available"},
    "then": [{"op": "setState", "values": {"card.welcome_action": 2}}, {"op": "action", "action": "mpWelcomeAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-join-slot-2"}]
   }
  ],
  "join_slot_3": [
   {
    "op": "if",
    "condition": {"state": "mp.join3.available"},
    "then": [{"op": "setState", "values": {"card.welcome_action": 3}}, {"op": "action", "action": "mpWelcomeAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-join-slot-3"}]
   }
  ],
  "join_solo_0": [
   {
    "op": "if",
    "condition": {"state": "mp.join0.available"},
    "then": [{"op": "setState", "values": {"card.welcome_action": 0}}, {"op": "action", "action": "mpWelcomeAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-join-solo-0"}]
   }
  ],
  "join_solo_1": [
   {
    "op": "if",
    "condition": {"state": "mp.join1.available"},
    "then": [{"op": "setState", "values": {"card.welcome_action": 1}}, {"op": "action", "action": "mpWelcomeAction"}],
    "else": [{"op": "playTimeline", "timeline": "shake-join-solo-1"}]
   }
  ],
  "classic_settings": [{"op": "setState", "values": {"card.stock_page": 3}}, {"op": "action", "action": "mpStockPage"}],
  "rail_0": [{"op": "setState", "values": {"card.rail": 0}}, {"op": "action", "action": "mpRail"}],
  "rail_1": [{"op": "setState", "values": {"card.rail": 1}}, {"op": "action", "action": "mpRail"}],
  "rail_2": [{"op": "setState", "values": {"card.rail": 2}}, {"op": "action", "action": "mpRail"}],
  "rail_3": [{"op": "setState", "values": {"card.rail": 3}}, {"op": "action", "action": "mpRail"}],
  "rail_4": [{"op": "setState", "values": {"card.rail": 4}}, {"op": "action", "action": "mpRail"}],
  "rail_5": [{"op": "setState", "values": {"card.rail": 5}}, {"op": "action", "action": "mpRail"}],
  "rail_6": [{"op": "setState", "values": {"card.rail": 6}}, {"op": "action", "action": "mpRail"}],
  "leaveModalShow": [
   {"op": "setState", "values": {"leaveModal.visible": true, "leaveModal.contents": false}},
   {"op": "playTimeline", "timeline": "leaveModalEnter"}
  ],
  "leaveModalShown": [{"op": "setState", "values": {"leaveModal.contents": true}}],
  "leaveModalHide": [
   {"op": "setState", "values": {"leaveModal.contents": false}},
   {"op": "playTimeline", "timeline": "leaveModalLeave"}
  ],
  "leaveModalHidden": [{"op": "setState", "values": {"leaveModal.visible": false}}],
  "tab_join": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 0]},
    "then": [
     {"op": "setState", "values": {"card.leaving": {"state": "card.tab"}, "card.tab": 0}},
     {"op": "playTimeline", "timeline": "show-join"},
     {
      "op": "if",
      "condition": {"state": "mp.welcome.team_mode"},
      "then": [{"op": "focus", "control": "join-slot-2"}],
      "else": [{"op": "focus", "control": "join-solo-0"}]
     }
    ]
   }
  ],
  "tab_server": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 1]},
    "then": [
     {"op": "setState", "values": {"card.leaving": {"state": "card.tab"}, "card.tab": 1}},
     {"op": "playTimeline", "timeline": "show-server"},
     {"op": "focus", "control": "tab-server"}
    ]
   }
  ],
  "tab_players": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 2]},
    "then": [
     {"op": "setState", "values": {"card.leaving": {"state": "card.tab"}, "card.tab": 2}},
     {"op": "playTimeline", "timeline": "show-players"},
     {"op": "focus", "control": "tab-players"}
    ]
   }
  ],
  "tab_settings": [
   {
    "op": "if",
    "condition": {"op": "!=", "args": [{"state": "card.tab"}, 3]},
    "then": [
     {"op": "setState", "values": {"card.leaving": {"state": "card.tab"}, "card.tab": 3}},
     {"op": "playTimeline", "timeline": "show-settings"},
     {"op": "focus", "control": "settings-name"}
    ]
   }
  ],
  "pageShown": [{"op": "setState", "values": {"card.leaving": -1}}],
  "onTabPrevious": [
   {
    "op": "if",
    "condition": {"op": "==", "args": [{"state": "card.tab"}, 0]},
    "then": [{"op": "call", "event": "tab_settings"}],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "card.tab"}, 1]},
      "then": [{"op": "call", "event": "tab_join"}],
      "else": [
       {
        "op": "if",
        "condition": {"op": "==", "args": [{"state": "card.tab"}, 2]},
        "then": [{"op": "call", "event": "tab_server"}],
        "else": [
         {
          "op": "if",
          "condition": {"op": "==", "args": [{"state": "card.tab"}, 3]},
          "then": [{"op": "call", "event": "tab_players"}]
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "onTabNext": [
   {
    "op": "if",
    "condition": {"op": "==", "args": [{"state": "card.tab"}, 0]},
    "then": [{"op": "call", "event": "tab_server"}],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "card.tab"}, 1]},
      "then": [{"op": "call", "event": "tab_players"}],
      "else": [
       {
        "op": "if",
        "condition": {"op": "==", "args": [{"state": "card.tab"}, 2]},
        "then": [{"op": "call", "event": "tab_settings"}],
        "else": [
         {
          "op": "if",
          "condition": {"op": "==", "args": [{"state": "card.tab"}, 3]},
          "then": [{"op": "call", "event": "tab_join"}]
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "open": [
   {"op": "setState", "values": {"card.released": false, "card.leaving": -1}},
   {
    "op": "if",
    "condition": {"state": "reduced_motion"},
    "then": [{"op": "playTimeline", "timeline": "open-reduced"}],
    "else": [{"op": "playTimeline", "timeline": "open"}]
   },
   {
    "op": "if",
    "condition": {"op": "==", "args": [{"state": "card.tab"}, 0]},
    "then": [
     {
      "op": "if",
      "condition": {"state": "mp.welcome.team_mode"},
      "then": [{"op": "focus", "control": "join-slot-2"}],
      "else": [{"op": "focus", "control": "join-solo-0"}]
     }
    ],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "card.tab"}, 1]},
      "then": [{"op": "focus", "control": "tab-server"}],
      "else": [
       {
        "op": "if",
        "condition": {"op": "==", "args": [{"state": "card.tab"}, 2]},
        "then": [{"op": "focus", "control": "tab-players"}],
        "else": [
         {
          "op": "if",
          "condition": {"op": "==", "args": [{"state": "card.tab"}, 3]},
          "then": [{"op": "focus", "control": "settings-name"}]
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "release": [{"op": "setState", "values": {"card.released": true}}, {"op": "playTimeline", "timeline": "release"}],
  "onActivate": [
   {
    "op": "if",
    "condition": {"state": "card.released"},
    "then": [{"op": "setState", "values": {"card.released": false}}, {"op": "playTimeline", "timeline": "unrelease"}]
   }
  ],
  "onBack": [{"op": "action", "action": "mpClose"}]
 },
