{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure openQ4 (Meson Optimized)",
      "detail": "Configure builddir-perf as debugoptimized, reconfiguring it in place when it exists.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "setup"
      ],
      "problemMatcher": []
    },
    {
      "label": "Compile openQ4 (Meson Optimized)",
      "detail": "Compile builddir-perf without staging anything.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "compile"
      ],
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Stage openQ4 Install Tree (Meson Optimized)",
      "detail": "Install builddir-perf into .install with meson install (no rebuild, no subprojects).",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "install"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build openQ4 (Meson Optimized)",
      "detail": "Compile builddir-perf, then copy changed runtime files into .install for the launch configurations.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "fastbuild"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Full Build and Stage openQ4 (Meson Optimized)",
      "detail": "Configure, compile and fully install builddir-perf into .install.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Configure openQ4 (Meson Optimized)",
        "Compile openQ4 (Meson Optimized)",
        "Stage openQ4 Install Tree (Meson Optimized)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Bake Light Grids (All MP)",
      "detail": "Full build and stage, then bake the light grids of every stock multiplayer map in a hidden client.",
      "type": "shell",
      "command": "${workspaceFolder}\\.install\\openQ4-client_x64.exe",
      "args": [
        "+set",
        "logFile",
        "2",
        "+set",
        "logFileName",
        "logs/openq4_lightgrids.log",
        "+set",
        "developer",
        "1",
        "+set",
        "s_noSound",
        "1",
        "+set",
        "r_hiddenWindow",
        "1",
        "+set",
        "r_fullscreen",
        "0",
        "+set",
        "fs_savepath",
        "${workspaceFolder}\\.home",
        "+set",
        "fs_devpath",
        "${workspaceFolder}\\.install",
        "+set",
        "fs_game",
        "baseoq4",
        "+set",
        "si_gameType",
        "dm",
        "+set",
        "net_serverDedicated",
        "0",
        "+set",
        "sv_cheats",
        "1",
        "+set",
        "net_allowCheats",
        "1",
        "+bakeLightGrids",
        "all-mp",
        "-quit"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "Full Build and Stage openQ4 (Meson Optimized)"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\.install"
      },
      "problemMatcher": []
    }
  ]
}
